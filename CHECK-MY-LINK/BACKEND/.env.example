# ==========================================
# CHECK MY LINK - Environment Configuration
# Developer: Krishan Kumar Verma
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/check_my_link
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/check_my_link?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/check_my_link

# Google Safe Browsing API v4 Key (Optional - Heuristic threat engine works independently)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create API Key -> Enable Safe Browsing APIs
GOOGLE_SAFE_BROWSING_KEY=

# Allowed CORS Origins (comma-separated)
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://localhost:5000

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
